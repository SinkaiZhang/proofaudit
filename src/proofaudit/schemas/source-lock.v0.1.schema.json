{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofaudit.org/schemas/source-lock.v0.1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "sources"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "sha256", "media_type", "redistributable"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "kind": {"enum": ["source_payload", "reference_metadata"]},
          "media_type": {"type": "string", "minLength": 1},
          "redistributable": {"type": "boolean"},
          "original_url": {"type": "string", "format": "uri"},
          "license": {"type": "string"}
        }
      }
    }
  }
}
