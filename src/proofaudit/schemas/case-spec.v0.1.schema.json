{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofaudit.org/schemas/case-spec.v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "claim", "pipeline", "source_lock", "plugin_manifests"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "claim": {"$ref": "#/$defs/path"},
    "pipeline": {"$ref": "#/$defs/path"},
    "source_lock": {"$ref": "#/$defs/path"},
    "plugin_manifests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "test_e2e": {"$ref": "#/$defs/path"}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"}}
}
